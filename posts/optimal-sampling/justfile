# Export the Ipe figures as cropped SVGs with LaTeX text rendered as paths.
export:
    iperender -svg overlap.ipe overlap.svg
    iperender -svg factor-tree.ipe factor-tree.svg
    iperender -svg max-suffix.ipe max-suffix.svg
    iperender -svg opt-minimizer.ipe opt-minimizer.svg
    iperender -svg max-factor-even.ipe max-factor-even.svg
    iperender -svg suffix-factorization.ipe suffix-factorization.svg
